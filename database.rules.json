{
  "rules": {
    "luffarschack": {
      "rooms": {
        "$code": {
          ".read": true,
          ".write": true
        }
      },
      "openRooms": {
        "$code": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['gameId', 'hostName', 'createdAt']) && newData.child('gameId').isString() && newData.child('hostName').isString() && newData.child('hostName').val().length <= 60"
        }
      },
      "profiles": {
        "$profileId": {
          ".read": true,
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['name', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60"
        }
      },
      "statsLog": {
        "$entryId": {
          ".read": true,
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['gameId', 'timestamp', 'players']) && newData.child('gameId').isString() && newData.child('timestamp').isNumber()"
        }
      }
    },

    "$other": {
      ".read": true,
      ".write": true
    }
  }
}
